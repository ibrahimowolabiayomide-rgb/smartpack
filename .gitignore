.vercel/
.turbo/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
pnpm-debug.log*

# Editor state
.idea/
.vscode/*
!.vscode/extensions.json

# Archives and review bundles must never be committed
*.zip
