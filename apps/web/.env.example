# SmartPack web application — server-side environment (copy to .env.local; never commit it).
# These values are read on the server only. Nothing here is exposed to the browser.

# Base URL of the SmartPack API, including the /api/v1 prefix. No trailing slash.
# Required in production and preview. In development it defaults to the value below.
API_URL=http://127.0.0.1:4000/api/v1

# Optional company branding, read on the server for each request (no rebuild needed to change it).
# Leave all three unset to show the default SmartPack name, mark and colours.
# Company name shown in the sidebar footer, sign-in page and Settings (1 to 80 characters).
BRAND_COMPANY_NAME=
# Logo: a path to a file in apps/web/public (starting with "/") or an https URL.
BRAND_LOGO_URL=
# The one accent colour as #rrggbb. Ignored, with a note on Settings, if text on it would fail WCAG AA.
BRAND_ACCENT_COLOR=
