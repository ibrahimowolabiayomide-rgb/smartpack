{
  "name": "@smartpack/web",
  "version": "0.1.0",
  "private": true,
  "description": "SmartPack web application (Next.js App Router).",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "pnpm --filter @smartpack/shared build && next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop-1440 --project=mobile-390",
    "test:e2e:full": "playwright test"
  },
  "dependencies": {
    "@smartpack/shared": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@smartpack/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
