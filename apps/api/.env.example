# SmartPack API — environment variables (copy to .env for local development; never commit .env).
# Every value below is a placeholder. See docs/ENVIRONMENT_VARIABLES.md for the full reference.

# development | test | production
NODE_ENV=development

# Port the API listens on, and the interface it binds (defaults: 4000, 127.0.0.1 in development
# and 0.0.0.0 in production). Hosting platforms usually inject PORT themselves.
PORT=4000
# HOST=

# fatal | error | warn | info | debug | trace | silent  (default: debug in development, info in production)
# LOG_LEVEL=

# Comma-separated list of web origins allowed to call the API: scheme + host (+ port), no path,
# no trailing slash. Required in production, where every origin must be https.
# Defaults in development to http://localhost:3000 and http://127.0.0.1:3000.
# CORS_ALLOWED_ORIGINS=https://your-web-app.example.com

# Publish Swagger UI at /api/docs. Default: true in development, false in production.
# ENABLE_API_DOCS=false

# PostgreSQL connection string. Must NOT contain sslmode/ssl parameters; use DATABASE_SSL.
DATABASE_URL=postgresql://smartpack:CHANGE_ME@localhost:5432/smartpack_dev

# disable | require | no-verify   (default: disable in development, require in production)
# DATABASE_SSL=disable

# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_QUERY_TIMEOUT_MS=10000

# --- Phase 3: accounts, sessions and email -------------------------------------------------------

# Public origin of the web application, used to build the links in emails. Required in production
# (must be https). For local development use the value below.
WEB_APP_URL=http://localhost:3000

# Number of reverse proxies in front of the API whose X-Forwarded-For is trusted (0 to 5).
# 0 when the API is reached directly. 1 when it sits behind the web app's gateway or one proxy.
# TRUST_PROXY_HOPS=0

# Session lifetime: a session unused for this long ends, and no session outlasts the absolute limit.
# SESSION_IDLE_TIMEOUT_MINUTES=480
# SESSION_ABSOLUTE_TIMEOUT_HOURS=168

# Argon2id password hashing. Production requires at least 19456 KiB and time cost 2.
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1

# One-time link lifetimes.
# INVITATION_TTL_HOURS=72
# PASSWORD_RESET_TTL_MINUTES=60
# EMAIL_VERIFICATION_TTL_HOURS=24

# Email: none | dev-capture | smtp | brevo. Default none (no email is sent).
# dev-capture keeps messages in memory for local development and is refused in production.
EMAIL_PROVIDER=dev-capture
# Only for EMAIL_PROVIDER=smtp (SMTP_USER and SMTP_PASSWORD must be set together):
# EMAIL_FROM=SmartPack <no-reply@your-company.example>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=CHANGE_ME

# Only for EMAIL_PROVIDER=brevo (Brevo transactional HTTP API). The sender must be verified in Brevo.
# EMAIL_SENDER_NAME=SmartPack
# EMAIL_SENDER_EMAIL=smartcompanyintegratedsystem@gmail.com
# BREVO_API_KEY=CHANGE_ME

# Rate limiting. Never disable it outside automated tests (refused in production).
# RATE_LIMIT_DISABLED=false
# RATE_LIMIT_SCALE=1

# First-owner command only (pnpm --filter @smartpack/api bootstrap). Leave unset to be prompted for
# the password. Do not keep a real password in this file.
# BOOTSTRAP_OWNER_PASSWORD=
