# SmartPack API — environment variables (copy to .env for local development; never commit .env).
# Every value below is a placeholder. See docs/ENVIRONMENT_VARIABLES.md for the full reference.

# development | test | production
NODE_ENV=development

# Port the API listens on, and the interface it binds (defaults: 4000, 127.0.0.1 in development
# and 0.0.0.0 in production). Hosting platforms usually inject PORT themselves.
PORT=4000
# HOST=

# fatal | error | warn | info | debug | trace | silent  (default: debug in development, info in production)
# LOG_LEVEL=

# Comma-separated list of web origins allowed to call the API: scheme + host (+ port), no path,
# no trailing slash. Required in production, where every origin must be https.
# Defaults in development to http://localhost:3000 and http://127.0.0.1:3000.
# CORS_ALLOWED_ORIGINS=https://your-web-app.example.com

# Publish Swagger UI at /api/docs. Default: true in development, false in production.
# ENABLE_API_DOCS=false

# PostgreSQL connection string. Must NOT contain sslmode/ssl parameters; use DATABASE_SSL.
DATABASE_URL=postgresql://smartpack:CHANGE_ME@localhost:5432/smartpack_dev

# disable | require | no-verify   (default: disable in development, require in production)
# DATABASE_SSL=disable

# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_QUERY_TIMEOUT_MS=10000
